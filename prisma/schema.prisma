// Prisma schema — hi-team weekly reports
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Пользователи (вход по email + паролю, JWT-сессии Auth.js)
// ---------------------------------------------------------------------------

enum Role {
  MEMBER // Сотрудник
  LEAD // Сотрудник-расширенный (пишет отчёты + управление)
  DIRECTOR // Руководитель (управление, отчёты не пишет)
}

// Подкоманда сотрудника: команда делится на две подгруппы. Определяет, в какой
// раздел AI-сводки недели попадают его отчёты. null = ещё не выбрана.
// Подкоманда (направление) в рамках команды. У каждой команды свой набор
// (напр. AI/BI у первой, у другой — свои). key — короткий тег для бейджа.
model Subteam {
  id          String @id @default(cuid())
  workspaceId String
  key         String // короткий тег, напр. «AI»
  label       String // отображаемое название
  order       Int    @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  users     User[]

  @@unique([workspaceId, key])
}

// Рабочее пространство (команда). Мультитенант: данные разных команд не
// пересекаются — у «командных» сущностей есть workspaceId, а запросы
// фильтруются по нему. Фаза 1: поле nullable, всё переносится в команду по
// умолчанию бэкфиллом; ужесточение и скоуп запросов — следующими фазами.
model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  // Переопределения системных промптов AI-сводок (null = дефолт из кода).
  weekPrompt  String? @db.Text
  monthPrompt String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  subteams       Subteam[]
  projects       Project[]
  reports        Report[]
  summaries      Summary[]
  monthSummaries MonthSummary[]
  allowedEmails  AllowedEmail[]
  botSettings    BotSettings[]
}

model User {
  id               String   @id @default(cuid())
  name             String?
  email            String   @unique
  passwordHash     String? // bcrypt; null = пароль ещё не задан (первый вход)
  image            String?
  role             Role     @default(MEMBER)
  workspaceId      String? // команда, к которой принадлежит пользователь
  isSuperAdmin     Boolean  @default(false) // управляет всеми командами
  subteamId        String? // подкоманда (направление) внутри команды; null = не выбрана
  active           Boolean  @default(true) // false = ушёл из команды: не логинится, не в дашборде
  vacationUntil    DateTime? @db.Date // в отпуске по эту дату включительно; пусто = не в отпуске. Пока в отпуске — не ждём отчёт и не шлём напоминания
  telegramChatId   String?  @unique // личный chat_id (привязка Telegram, персональные напоминания)
  telegramUsername String? // @username на момент привязки — для отображения
  createdAt        DateTime @default(now())

  workspace       Workspace? @relation(fields: [workspaceId], references: [id])
  subteam         Subteam?   @relation(fields: [subteamId], references: [id])
  reports         Report[]
  telegramLink    TelegramLink?
  reviewPreps     ReviewPrep[]
  directorReports DirectorReport[]
  notes           Note[]
}

// Личная подготовка сотрудника к встрече 1:1 с руководителем: AI-резюме
// собственной работы за выбранный период. Виден только автору.
model ReviewPrep {
  id          String   @id @default(cuid())
  userId      String
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  label       String // напр. «II квартал 2026»
  focus       String?  @db.Text // необязательный акцент от сотрудника
  content     String   @db.Text
  model       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart, periodEnd])
  @@index([userId])
}

// Одноразовый код привязки Telegram: пользователь запускает бота с /start <code>.
model TelegramLink {
  code      String   @id
  userId    String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Настройки бота (единственная запись id="singleton"): расписание личных
// напоминаний не сдавшим и групповой сводки «кто сдал / кто нет».
// Время задаётся в timezone; почасовой крон проверяет совпадение.
model BotSettings {
  id              String   @id @default(cuid())
  workspaceId     String?  @unique // одна настройка бота на команду
  // Личные напоминания в ЛС тем, кто не сдал отчёт.
  reminderEnabled Boolean  @default(false)
  reminderDow     Int      @default(4) // день недели 1=Пн … 7=Вс
  reminderHour    Int      @default(10) // час 0–23 в timezone
  // Сводка-ростер в общий групповой чат (регистрируется командой /here).
  groupChatId     String?
  groupTitle      String?
  groupEnabled    Boolean  @default(false)
  groupDow        Int      @default(5)
  groupHour       Int      @default(12)
  timezone        String   @default("Europe/Moscow")
  // Дедуп запусков крона: YYYY-MM-DD (локальная дата) последнего срабатывания.
  lastReminderKey String?
  lastGroupKey    String?
  updatedAt       DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
}

// Состояние диалога бота по чату (serverless — храним в БД, не в памяти).
model TelegramDialog {
  chatId       String   @id
  state        String // idle | awaiting_report | confirming
  weekStartIso String? // неделя, за которую заполняется отчёт (YYYY-MM-DD)
  draft        String?  @db.Text // JSON распознанных проектов, ждущих подтверждения
  updatedAt    DateTime @updatedAt
}

// Allowlist почт для входа. Если таблица пуста — fallback на env ALLOWED_EMAILS.
model AllowedEmail {
  id          String   @id @default(cuid())
  email       String   @unique
  workspaceId String?
  role        Role     @default(MEMBER) // роль, которую получит человек при первом входе
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
}

// ---------------------------------------------------------------------------
// Domain: weekly reports
// ---------------------------------------------------------------------------

enum ProjectStatus {
  ACTIVE
  PAUSED
  DONE
}

// Проект/направление как сущность: статус, история по неделям, AI-статус.
model Project {
  id             String        @id @default(cuid())
  workspaceId    String?
  name           String
  status         ProjectStatus @default(ACTIVE)
  aiSummary      String?       @db.Text // последняя AI-сводка по проекту
  aiSummaryModel String?
  aiSummaryAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workspace Workspace?      @relation(fields: [workspaceId], references: [id])
  entries   ReportProject[]

  @@unique([workspaceId, name]) // имена проектов уникальны в рамках команды
}

model Week {
  id        String   @id @default(cuid())
  label     String // напр. «15–19 июня»
  startDate DateTime @unique @db.Date
  endDate   DateTime @db.Date

  reports         Report[]
  summaries       Summary[] // по одной сводке на команду
  directorReports DirectorReport[]

  @@index([startDate])
}

model Report {
  id          String   @id @default(cuid())
  userId      String
  weekId      String
  workspaceId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  week      Week            @relation(fields: [weekId], references: [id], onDelete: Cascade)
  workspace Workspace?      @relation(fields: [workspaceId], references: [id])
  projects  ReportProject[]

  @@unique([userId, weekId])
}

model ReportProject {
  id        String  @id @default(cuid())
  reportId  String
  projectId String? // null только у строк до бэкфилла (prisma/backfill-projects.ts)
  name      String // название проекта/направления (снимок на момент отчёта)
  done      String  @default("") @db.Text // Сделано
  blockers  String  @default("") @db.Text // Блокеры
  plans     String  @default("") @db.Text // Планы
  order     Int     @default(0)

  report  Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@index([projectId])
}

// Приватный недельный отчёт руководителя (роль DIRECTOR). Отдельные таблицы,
// чтобы данные НЕ попадали в командный дашборд, AI-сводки, экспорт и аналитику.
// Виден только автору в разделе /director.
model DirectorReport {
  id        String   @id @default(cuid())
  authorId  String
  weekId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User                    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  week     Week                    @relation(fields: [weekId], references: [id], onDelete: Cascade)
  projects DirectorReportProject[]

  @@unique([authorId, weekId])
}

model DirectorReportProject {
  id       String @id @default(cuid())
  reportId String
  name     String
  done     String @default("") @db.Text
  blockers String @default("") @db.Text
  plans    String @default("") @db.Text
  order    Int    @default(0)

  report DirectorReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

// Личные заметки пользователя (мысли, статусы). Приватные — видны только автору.
model Note {
  id        String   @id @default(cuid())
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Сгенерированная ИИ сводка месяца (для отчётности наверх)
model MonthSummary {
  id          String   @id @default(cuid())
  month       String // YYYY-MM
  workspaceId String?
  content     String   @db.Text
  model       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, month])
}

// Сгенерированная ИИ сводка недели для руководителя
model Summary {
  id          String   @id @default(cuid())
  weekId      String
  workspaceId String?
  content     String   @db.Text
  model       String
  createdAt   DateTime @default(now())

  week      Week       @relation(fields: [weekId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@unique([weekId, workspaceId])
}
